# ─────────────────────────────────────────────────────────────
# AI Voice Document Assistant — environment variables
# Copy this file to `.env.local` and fill in the values.
# NEVER expose secret keys with the NEXT_PUBLIC_ prefix.
# ─────────────────────────────────────────────────────────────

# --- LLM brain (server-only, OpenAI-compatible) ---
# The app talks to OpenAI's Chat Completions API — which many providers speak,
# so you can point it at a FREE tier or a local model without code changes.
# Set OPENAI_API_KEY (any provider's key) and, for a non-OpenAI provider, also
# set OPENAI_BASE_URL and OPENAI_REASONING_MODEL. The model MUST support tool/
# function calling.
OPENAI_API_KEY=sk-...

# Model used by the reasoning engine (function-calling capable).
OPENAI_REASONING_MODEL=gpt-4o

# Optional: point at any OpenAI-compatible endpoint. Leave unset for OpenAI.
# Free options (no cost):
#   Groq (free, fast):   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#                        OPENAI_REASONING_MODEL=llama-3.3-70b-versatile
#   Google Gemini (free): OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                         OPENAI_REASONING_MODEL=gemini-2.0-flash
#   Ollama (local, free): OPENAI_BASE_URL=http://localhost:11434/v1
#                         OPENAI_REASONING_MODEL=llama3.1
# OPENAI_BASE_URL=
# Model used for the OpenAI Realtime speech session.
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# --- Supabase ---
# The URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The service role key is server-only. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Speech-to-Text ---
# Which STT provider the client should use: "realtime" | "whisper"
NEXT_PUBLIC_STT_PROVIDER=realtime
