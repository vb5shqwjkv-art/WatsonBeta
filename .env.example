# ─────────────────────────────────────────────────────────────
# AI Voice Document Assistant — environment variables
# Copy this file to `.env.local` and fill in the values.
# NEVER expose secret keys with the NEXT_PUBLIC_ prefix.
# ─────────────────────────────────────────────────────────────

# --- OpenAI (server-only) ---
# Used by the AI Reasoning Engine and Speech-to-Text providers.
OPENAI_API_KEY=sk-...

# Model used by the reasoning engine (function-calling capable).
OPENAI_REASONING_MODEL=gpt-4o
# Model used for the OpenAI Realtime speech session.
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# --- Supabase ---
# The URL and anon key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The service role key is server-only. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Speech-to-Text ---
# Which STT provider the client should use: "realtime" | "whisper"
NEXT_PUBLIC_STT_PROVIDER=realtime
