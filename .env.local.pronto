# ─────────────────────────────────────────────────────────────
#  CONFIGURAZIONE PRONTA — assistente vocale per studiare
#  Cervello: Google Gemini (GRATIS)
# ─────────────────────────────────────────────────────────────
#  1. Rinomina questo file da ".env.local.pronto" a ".env.local"
#  2. Incolla la tua chiave Google qui sotto (al posto di AIza-INCOLLA...)
#     La chiave gratuita si prende su  https://aistudio.google.com  → "Get API key"
#  3. Salva. È tutto: avvia con  npm run dev
# ─────────────────────────────────────────────────────────────

OPENAI_API_KEY=AIza-INCOLLA-QUI-LA-TUA-CHIAVE-GOOGLE
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_REASONING_MODEL=gemini-2.0-flash


# ─────────────────────────────────────────────────────────────
#  RETE DI SALVATAGGIO (solo se Gemini dà problemi con qualche comando)
#  Passa a OpenAI gpt-4o-mini (costa pochi centesimi, non euro):
#   - metti un # davanti alle 3 righe Gemini qui sopra
#   - togli il # dalle 2 righe qui sotto e incolla la chiave OpenAI (sk-...)
# ─────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-INCOLLA-QUI-LA-TUA-CHIAVE-OPENAI
# OPENAI_REASONING_MODEL=gpt-4o-mini
